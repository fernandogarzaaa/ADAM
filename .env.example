# Environment variables read by ADAM. Copy to .env (or export them) as needed.
# No values are committed here on purpose; every variable is optional.

# adam-mcp server (crates/adam-mcp/src/main.rs)
# Paths to the organism's live state (defaults: ./adam_memory.db, ./adam_genome.json, .)
ADAM_MEMORY_PATH=
ADAM_GENOME_PATH=
ADAM_DATA_DIR=

# Embedding model cache directory (crates/adam-organism/src/embedding.rs)
ADAM_EMBEDDING_CACHE_DIR=

# Cross-repo integration test: path to EVE's bin/eve-cp1.js (crates/adam-eve/tests)
ADAM_EVE_CP1=

# adam-pcr closed_loop example
EVE_CP1_SCRIPT=
GENESIS_RUN_DIR=
